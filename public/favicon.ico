<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="emergencyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#b91c1c" />
      <stop offset="100%" stop-color="#ef4444" />
    </linearGradient>
  </defs>
  <!-- Red Emergency Shield Background -->
  <rect width="64" height="64" rx="16" fill="url(#emergencyGrad)" />
  <rect width="60" height="60" x="2" y="2" rx="14" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="2" />
  <!-- White Medical Cross -->
  <rect x="26" y="12" width="12" height="40" rx="3" fill="#ffffff" />
  <rect x="12" y="26" width="40" height="12" rx="3" fill="#ffffff" />
</svg>
